# Supabase / Postgres connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Cryptographic secret for signing admin and participant session tokens (PRD 6.3)
# Generate a strong 32-byte secret using: openssl rand -hex 32
# Required in production. Do NOT commit the actual secret.
CAP_ADMIN_SECRET=

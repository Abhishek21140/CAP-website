
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Data layer: set to "memory" to force in-memory store (ignores DATABASE_URL); set to "postgres" for Supabase
DATA_LAYER=postgres

# Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key for signing admin session cookies (32+ chars)
SESSION_SECRET=cap-admin-super-secret-session-key-minimum-32-chars-long
